# Скопіюй у .env і заповни потрібне. Файл .env НЕ комітиться.
# Рекомендований спосіб зберігати ключі — системний keyring: команда /key <сервіс> у застосунку.

ANTHROPIC_API_KEY=        # розмова, /explain, ко-пілот листування — platform.claude.com
HIBP_API_KEY=             # /breach — haveibeenpwned.com/API/Key (платний)
ETHERSCAN_API_KEY=        # /approvals — etherscan.io/apis (безкоштовний)
ABUSECH_AUTH_KEY=         # /file → MalwareBazaar — auth.abuse.ch (безкоштовний)

# Необов'язково
# PHANTOMSTALKER_DB=~/.phantomstalker/phantom.db
# PHANTOMSTALKER_CACHE=~/.phantomstalker/cache
